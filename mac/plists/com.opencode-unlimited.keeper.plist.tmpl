<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.opencode-unlimited.keeper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/.local/share/opencode-unlimited/scripts/warp-keeper.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>OUC_HOME</key><string>__HOME__/.local/share/opencode-unlimited</string>
    <key>OUC_WARP_BIN</key><string>__WARP__</string>
    <key>OUC_LEAKGUARD</key><string>0</string>
    <key>PATH</key><string>__PATH__</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>20</integer>
  <key>StandardOutPath</key><string>__HOME__/.local/share/opencode-unlimited/guard/keeper-daemon.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.local/share/opencode-unlimited/guard/keeper-daemon.log</string>
</dict>
</plist>
