<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.opencode-unlimited.overlay</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/Library/Application Support/opencode-unlimited/OpencodeOverlay.app/Contents/MacOS/opencode-unlimited-overlay</string>
  </array>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>__HOME__/.local/share/opencode-unlimited/guard/overlay-daemon.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.local/share/opencode-unlimited/guard/overlay-daemon.log</string>
</dict>
</plist>
